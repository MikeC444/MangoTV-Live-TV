# Copy this file to .env.test and fill in a connection string that points
# at a disposable database ONLY — the test suite runs TRUNCATE between
# every test. Deliberately a separate file/variable from .env's
# DATABASE_URL: running `npm test` never reads DATABASE_URL at all, so a
# real (dev or production) database is never at risk just because it
# happened to be configured in .env when the test suite ran.
TEST_DATABASE_URL=
