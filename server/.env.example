# Copy this file to .env and fill in real values. Never commit .env —
# it's already covered by server/.gitignore.

# Neon Postgres connection string (use the *pooled* connection string from
# the Neon console for anything but the migration runner, which should use
# the direct/unpooled connection so DDL runs on a stable session).
# Example shape: postgresql://<user>:<password>@<host>/<database>?sslmode=require
DATABASE_URL=

# Random secret used to sign/verify auth-related tokens introduced in
# Milestone 3. Generate with: openssl rand -hex 32
JWT_SECRET=

# Random secret used to sign/verify QR activation tokens introduced in
# Milestone 4. Generate with: openssl rand -hex 32
QR_AUTH_SECRET=

# Public base URL this API is reachable at once deployed (used to build
# the QR activation URL in Milestone 4, e.g. https://api.example.com).
API_BASE_URL=

# development | production — gates things like verbose error responses.
NODE_ENV=development

# Port the HTTP server listens on (Milestone 2).
PORT=3000
