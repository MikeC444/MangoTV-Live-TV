# Copy this file to .env and fill in real values. Never commit .env —
# it's already covered by server/.gitignore.

# Neon Postgres connection string (use the *pooled* connection string from
# the Neon console for anything but the migration runner, which should use
# the direct/unpooled connection so DDL runs on a stable session).
# Use sslmode=verify-full, not require: node-postgres currently treats
# `require` as an alias for `verify-full` (full certificate verification,
# which is what we want), but that alias is deprecated and a future major
# version drops to weaker libpq-standard semantics for `require`. Being
# explicit now means this connection string's security guarantee doesn't
# silently change on a future `pg`/`pg-connection-string` upgrade.
# Example shape: postgresql://<user>:<password>@<host>/<database>?sslmode=verify-full
DATABASE_URL=

# Public base URL this API is reachable at (used to build the QR
# activation URL: <API_BASE_URL>/activate?token=...). For local
# development this is just where the dev server listens, e.g.
# http://localhost:3000; once deployed, the real public URL, e.g.
# https://api.example.com.
API_BASE_URL=

# development | production — gates things like verbose error responses.
NODE_ENV=development

# Port the HTTP server listens on (Milestone 2).
PORT=3000
