# Force npm to always install devDependencies, regardless of NODE_ENV.
#
# TypeScript itself and every @types/* package (express, node, pg) are
# devDependencies -- correct, since none of them are needed at runtime,
# only to compile. But `npm install`/`npm ci` skips devDependencies
# whenever NODE_ENV=production is set in the environment they run in --
# and most real hosts (Render, Railway, Heroku, ...) set exactly that
# during the build step, not just at runtime. Without this, `npm run
# build` fails on every real deployment with a wall of "implicitly has
# an 'any' type" / "could not find a declaration file" errors, because
# the compiler has no type packages to check against -- discovered via
# a real Render deploy attempt, never caught by CI (GitHub Actions
# runners don't set NODE_ENV=production during npm ci).
production=false
