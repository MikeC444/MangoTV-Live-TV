{
  "name": "mangotv-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for MangoTV account, authentication, and cloud sync — sits between the Fire TV app and Neon Postgres. The Fire TV app never connects to Postgres directly.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "tsx src/db/migrate.ts",
    "verify-schema": "tsx scripts/verify-schema.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "tsx scripts/migrate-test-db.ts",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  }
}
