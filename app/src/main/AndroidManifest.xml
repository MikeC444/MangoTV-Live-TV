<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
      usesCleartextTraffic is intentional, not an oversight (audited in
      Milestone 14): the addon ecosystem (StremioAddonClient, AddonUrl)
      fetches arbitrary user-supplied http:// and https:// addon manifest
      URLs by design, and this flag is what lets an http:// one work at
      all. It does NOT cover the account API traffic added in Milestones
      2 through 13; that traffic's own safety comes from
      app/build.gradle.kts requiring API_BASE_URL to start with https://,
      enforced at build time (a stronger guarantee than this flag could
      give either way, since it can't be scoped to a hostname only known
      at build time). Do not remove this flag to "fix" the account API's
      transport security; that fix already lives in build.gradle.kts,
      and removing this would break the addon ecosystem instead.
    -->
    <application
        android:name=".MangoTvApplication"
        android:allowBackup="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.MangoTV"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MangoTV">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
